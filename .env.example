# 服务器
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Docker 部署 — 宿主机端口（容器内固定 3000；阿里云此服务器开放 9000-9099）
# 不设置默认 9020；要换其他端口直接改这一行
HOST_PORT=9020

# 单次 chat 生成的硬超时(毫秒)；默认 20 分钟;reasoning model 如 deepseek-v4-pro / o1 推荐 30 分钟
# CHAT_RUN_TIMEOUT_MS=1800000

# 数据库
DB_PATH=./data/mockforge.db

# JWT
JWT_SECRET=your-jwt-secret-change-this
JWT_EXPIRES_IN=7d

# 加密（API Key 存储，必须 32 字符）
ENCRYPTION_KEY=your-32-char-encryption-key-here

# MCP API Key HMAC 密钥（用于对外 API Key 的哈希存储；建议 32+ 字节随机）
# 首次启动若未设置会自动生成并写入 .env
MCP_API_KEY_SECRET=

# MCP 对外公开 URL（强烈建议在远程/Docker 部署时设置）
# 用途：list_modules / create_module_from_spec 返回的 mockBaseUrl 用这个值拼。
# 不设时优先从请求 X-Forwarded-Proto/Host/Port 或 Host header 推断；都没有再 fall back 到
# http://localhost:<PORT>（仅本机直连有效；远程部署下 AI 拿到 localhost URL 写进业务代码会挂）。
# 例（直连容器宿主机）：MCP_PUBLIC_URL=http://39.108.114.224:9020
# 例（反代域名）：    MCP_PUBLIC_URL=https://mockforge.example.com
# MCP_PUBLIC_URL=

# 管理员初始化
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 注册控制
ALLOW_REGISTRATION=true

# 文件上传
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_CLEANUP_HOURS=24

# AI 默认配置（可选）
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=doubao-seed-2-0-pro-260215
DEFAULT_AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEFAULT_AI_API_KEY=
