# 服务器
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Docker 部署 — 宿主机端口（容器内固定 3000；阿里云此服务器开放 9000-9099）
# 不设置默认 9020；要换其他端口直接改这一行
HOST_PORT=9020

# 数据库
DB_PATH=./data/mockforge.db

# JWT
JWT_SECRET=your-jwt-secret-change-this
JWT_EXPIRES_IN=7d

# 加密（API Key 存储，必须 32 字符）
ENCRYPTION_KEY=your-32-char-encryption-key-here

# MCP API Key HMAC 密钥（用于对外 API Key 的哈希存储；建议 32+ 字节随机）
# 首次启动若未设置会自动生成并写入 .env
MCP_API_KEY_SECRET=

# 管理员初始化
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 注册控制
ALLOW_REGISTRATION=true

# 文件上传
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_CLEANUP_HOURS=24

# AI 默认配置（可选）
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=doubao-seed-2-0-pro-260215
DEFAULT_AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEFAULT_AI_API_KEY=
