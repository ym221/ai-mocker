  "description": "AI-driven Mock API platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch --ignore=./generated/** --ignore=./data/** --ignore=./uploads/** --env-file .env src/server/server.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json --noCheck",
    "start": "node dist/server/server.js"
